# ---------- shared ----------
# postgres (docker compose)
POSTGRES_DB=sbdesign
POSTGRES_USER=sb
POSTGRES_PASSWORD=sb_secret

# ---------- backend ----------
# ใน docker compose จะ override เป็น postgresql+psycopg://sb:sb_secret@db:5432/sbdesign
# รันในเครื่องโดยไม่มี Postgres ใช้ sqlite ได้: sqlite:///./sbdesign.db  (ดู backend/.env)
DATABASE_URL=postgresql+psycopg://sb:sb_secret@localhost:5432/sbdesign
JWT_SECRET=change-me-please-32-chars-minimum-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# SAP adapter: mock | rfc | http   (ของจริงใช้ rfc — pyrfc + SAP NW RFC SDK)
SAP_MODE=mock
SAP_TIMEOUT_SECONDS=3
# rfc: ค่าเชื่อมต่อขอจากทีม SAP (Basis)
SAP_RFC_ASHOST=
SAP_RFC_SYSNR=00
SAP_RFC_CLIENT=100
SAP_RFC_USER=
SAP_RFC_PASSWD=
SAP_RFC_LANG=TH
# http: ใช้เมื่อทีมหลังบ้านห่อ RFC เป็น REST gateway ให้
SAP_BASE_URL=http://sap-mock:9000

SALES_CART_TTL_HOURS=4
STAFF_DISCOUNT_QUOTA_PERCENT=3
QUOTATION_VALID_DAYS=7
OTP_DEBUG=true
PAYMENT_WEBHOOK_SECRET=payment-webhook-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- web ----------
VITE_API_BASE=/api

# soft launch: true = หน้าเข้าสู่ระบบขึ้น "เร็ว ๆ นี้" และปิดการสมัครสมาชิก
# เข้าได้เฉพาะบัญชีที่มีอยู่แล้ว (สร้างด้วย python -m app.cli.testers add)
INVITE_ONLY=false
COMING_SOON_TITLE=เร็ว ๆ นี้
COMING_SOON_TEXT=เรากำลังเตรียมร้านค้าออนไลน์ให้พร้อมที่สุด อีกไม่นานเจอกันแน่นอน

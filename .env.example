# ---------- shared ----------
# postgres (docker compose)
# ไม่มีรหัสตั้งต้นให้ — ของเดิมคือ sb_secret ซึ่งอยู่ใน git ให้ทุกคนอ่าน แล้วกลายเป็น
# รหัสฐานข้อมูลจริงบนเซิร์ฟเวอร์เพราะไม่มีใครเปลี่ยน · ตั้งเองในไฟล์ .env (ไม่ขึ้น git)
POSTGRES_DB=sbdesign
POSTGRES_USER=sb
POSTGRES_PASSWORD=

# ---------- backend ----------
# docker compose ประกอบ DATABASE_URL ให้เองจาก POSTGRES_* ข้างบน (ชี้ไปที่ host "db")
# รันในเครื่องโดยไม่มี Postgres ใช้ sqlite ได้: sqlite:///./sbdesign.db  (ดู backend/.env)
DATABASE_URL=sqlite:///./sbdesign.db
JWT_SECRET=change-me-please-32-chars-minimum-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# SAP adapter: mock | rfc | http   (ของจริงใช้ rfc — pyrfc + SAP NW RFC SDK)
SAP_MODE=mock
SAP_TIMEOUT_SECONDS=3
# rfc: ค่าเชื่อมต่อขอจากทีม SAP (Basis)
SAP_RFC_ASHOST=
SAP_RFC_SYSNR=00
SAP_RFC_CLIENT=100
SAP_RFC_USER=
SAP_RFC_PASSWD=
SAP_RFC_LANG=TH
# http: ใช้เมื่อทีมหลังบ้านห่อ RFC เป็น REST gateway ให้
SAP_BASE_URL=http://sap-mock:9000

SALES_CART_TTL_HOURS=4
STAFF_DISCOUNT_QUOTA_PERCENT=3
QUOTATION_VALID_DAYS=7
OTP_DEBUG=true
PAYMENT_WEBHOOK_SECRET=payment-webhook-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- web ----------
VITE_API_BASE=/api

# soft launch: true = หน้าเข้าสู่ระบบขึ้น "เร็ว ๆ นี้" และปิดการสมัครสมาชิก
# เข้าได้เฉพาะบัญชีที่มีอยู่แล้ว (สร้างด้วย python -m app.cli.testers add)
INVITE_ONLY=false
# รับมัดจำไหม — ปิดไว้ ตอนนี้รับชำระเต็มจำนวนอย่างเดียว
# ยอดมัดจำยังคิดและเก็บไว้ในใบเสนอราคา (deposit_amount) พร้อมเปิดใช้วันที่ตกลงเงื่อนไขได้
DEPOSIT_ENABLED=false
# ให้เซลล์กดลดราคาเองได้ไหม — ปิดไว้ ส่วนลดต้องมาจากโปรโมชั่นที่ตั้งไว้
# โค้ดกับด่านอนุมัติของผู้จัดการยังอยู่ครบ เปิดคืนได้วันที่นโยบายเปลี่ยน
STAFF_DISCOUNT_ENABLED=false

# ---------- ช่องทางรับชำระเงิน ----------
# mock  = หน้าธนาคารจำลองของเราเอง ไม่มีเงินเคลื่อนไหวจริง
# kbank = K-Payment Gateway กสิกร (ยังต่อไม่ได้ รอคีย์ + เอกสาร API)
PAYMENT_PROVIDER=mock
# เปิดปุ่มจ่ายเงินจำลองบนเครื่องที่ตั้ง APP_ENV=prod (เว็บทดสอบ) — ของจริงต้องปิด
# ใช้ได้เฉพาะตอน PAYMENT_PROVIDER=mock เท่านั้น
MOCK_PAYMENT_ENABLED=false
KBANK_BASE_URL=
KBANK_MERCHANT_ID=
KBANK_PUBLIC_KEY=
KBANK_SECRET_KEY=

# ---------- หัวใบเสนอราคา ----------
# ไม่ตั้ง = ใช้ค่าตั้งต้นในโค้ด (ถอดมาจากใบรับคำสั่งซื้อของระบบเดิม)
COMPANY_NAME_TH=
COMPANY_NAME_EN=
COMPANY_ADDRESS_TH=
COMPANY_TAX_ID=

# ---------- ท้ายใบเสนอราคา ----------
# เว้นว่าง = ใช้เงื่อนไขมาตรฐานใน app/api/quotation_doc.py (DEFAULT_TERMS)
# ตั้งค่านี้เมื่อจะเขียนทับทั้งก้อน: คั่นแต่ละข้อด้วย | และขึ้นบรรทัดใหม่ในข้อเดียวกันด้วย ;
# {valid_until} จะถูกแทนด้วยวันยืนราคาของใบนั้นๆ
QUOTATION_TERMS=
COMING_SOON_TITLE=เร็ว ๆ นี้
COMING_SOON_TEXT=เรากำลังเตรียมร้านค้าออนไลน์ให้พร้อมที่สุด อีกไม่นานเจอกันแน่นอน

# ---------- shared ----------
# postgres (docker compose)
POSTGRES_DB=sbdesign
POSTGRES_USER=sb
POSTGRES_PASSWORD=sb_secret

# ---------- backend ----------
# ใน docker compose จะ override เป็น postgresql+psycopg://sb:sb_secret@db:5432/sbdesign
# รันในเครื่องโดยไม่มี Postgres ใช้ sqlite ได้: sqlite:///./sbdesign.db
DATABASE_URL=postgresql+psycopg://sb:sb_secret@localhost:5432/sbdesign
JWT_SECRET=change-me-please-32-chars-minimum-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
# mock | http
SAP_MODE=mock
SAP_BASE_URL=http://sap-mock:9000
SAP_TIMEOUT_SECONDS=3
SALES_CART_TTL_HOURS=4
STAFF_DISCOUNT_QUOTA_PERCENT=3
QUOTATION_VALID_DAYS=7
OTP_DEBUG=true
PAYMENT_WEBHOOK_SECRET=payment-webhook-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- web ----------
VITE_API_BASE=/api
